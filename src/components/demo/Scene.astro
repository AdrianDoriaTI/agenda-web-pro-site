---
// Estrutura comum dos momentos com celular (DESIGN §5.4): título da seção, palco fixo,
// legenda por etapa, bolinhas, Anterior/Próxima e marcadores de rolagem.
// Os aparelhos entram pelo slot. `duo`: em telas largas, notebook + celular lado a lado.
import '../../styles/demo.css';

interface Etapa { titulo: string; texto: string }
interface Props {
  id: string;
  rotulo: string;
  titulo: string;
  lead: string;
  etapas: readonly Etapa[];
  aria: string;
  zoom?: string;
  duo?: boolean;
  /** No celular, o zoom mantém o topo da tela à vista (em vez de centralizar a área em foco). */
  zoomTopo?: boolean;
}
const { id, rotulo, titulo, lead, etapas, aria, zoom = '', duo = false, zoomTopo = false } = Astro.props;
const total = etapas.length;
const pad = (n: number) => String(n).padStart(2, '0');
---
<section id={id} aria-labelledby={`${id}-titulo`}>
  <div class="wrap sc-head">
    <p class="t-label reveal" style="color:var(--brown)">{rotulo}</p>
    <h2 id={`${id}-titulo`} class="t-h2 reveal" style="--i:1;margin-top:16px;max-width:18ch">{titulo}</h2>
    <p class="t-lead reveal" style="--i:2;margin-top:16px;max-width:40ch">{lead}</p>
  </div>

  <div class:list={['scene', { duo }]} data-scene data-zoom={zoom} data-mzoom={zoomTopo ? 'topo' : undefined} role="group" aria-label={aria}>
    <div class="stage wrap">
      <div class="cap">
        <div class="cap-top">
          <p class="t-label cap-count tnum"><span data-count>01</span> / {pad(total)}</p>
          <div class="dots" role="group" aria-label="Etapas da demonstração">
            {etapas.map((e, i) => (
              <button type="button" class="dot" data-dot={i + 1} aria-label={`Etapa ${i + 1} de ${total}: ${e.titulo}`}><i></i></button>
            ))}
          </div>
        </div>
        <p class="swipe-hint t-label" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v12M4.5 5.5 8 2l3.5 3.5M4.5 10.5 8 14l3.5-3.5"/></svg>
          Deslize na imagem para ver as etapas
        </p>
        <ol class="cap-items" aria-live="polite">
          {etapas.map((e, i) => (
            <li class="cap-item" data-cap={i + 1}>
              <h3 class="t-h3">{e.titulo}</h3>
              <p class="cap-txt">{e.texto}</p>
            </li>
          ))}
        </ol>
        <div class="cap-nav">
          <button type="button" class="btn btn-secondary btn-sm" data-prev>Anterior</button>
          <button type="button" class="btn btn-secondary btn-sm" data-next>Próxima</button>
        </div>
      </div>

      <div class="dev-row">
        <!-- Celular: trilho vertical à esquerda da caixa; a linha acompanha o deslizar dentro dela.
             Some a partir do tablet. -->
        <div class="rail" data-rail role="group" aria-label="Etapas da demonstração">
          <span class="rail-track" aria-hidden="true"><span class="rail-fill"></span></span>
          {etapas.map((e, i) => (
            <button type="button" class="rail-dot tnum" data-dot={i + 1} aria-label={`Etapa ${i + 1} de ${total}: ${e.titulo}`}>{pad(i + 1)}</button>
          ))}
        </div>
        <div class="dev">
          <slot />
          <!-- Celular: camada que recebe o deslizar (uma página por etapa, com encaixe). -->
          <div class="swipe" data-swipe aria-hidden="true" tabindex="-1">{etapas.map(() => <span></span>)}</div>
        </div>
      </div>
    </div>

    <div class="markers" aria-hidden="true">
      {etapas.map(() => <div data-marker></div>)}
    </div>
  </div>
</section>

<script>
  import '../../scripts/scene';
</script>

<style>
  .sc-head { padding-top: 40px; }
  @media (min-width: 48rem) { .sc-head { padding-top: 72px; } }
  @media (min-width: 64rem) { .sc-head { padding-top: 96px; } }

  .scene { display: grid; }
  .stage, .markers { grid-area: 1 / 1; }
  .markers { padding-bottom: 30svh; }
  .markers > div { height: 70svh; }

  .stage {
    position: sticky; top: 0; align-self: start; height: 100svh; min-height: 560px;
    display: grid; grid-template-rows: minmax(0, 1fr) auto; gap: 12px;
    padding-top: 80px; padding-bottom: 16px;
    /* Celular: o que couber em altura, até 300 px de largura (200 px = legenda + rótulo do celular). */
    --phone-w: clamp(190px, calc((100svh - 80px - 16px - 12px - 200px) * 9 / 19.5), 300px);
  }
  .dev { order: -1; position: relative; display: flex; justify-content: center; align-items: center; min-height: 0; }
  /* Tela pequena: palco normal (não fixo). As etapas passam deslizando dentro da caixa, menor que a
     tela; fora dela a página rola sem mexer nas imagens (D27). */
  @media (max-width: 47.99rem) {
    .markers { display: none; }
    .stage {
      position: static; height: auto; min-height: 0;
      grid-template-rows: auto auto; align-content: start; gap: 14px;
      padding-top: 28px; padding-bottom: 8px;
      --dev-h: clamp(340px, 62svh, 540px);
      --phone-w: calc(var(--dev-h) * 9 / 19.5);
    }
    .dev-row { order: -1; display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 10px; }
    .dev { order: 0; height: var(--dev-h); overflow: hidden; border-radius: 20px; box-shadow: inset 0 0 0 1px var(--line); }
    .swipe { position: absolute; inset: 0; z-index: 3; overflow-y: auto; scroll-snap-type: y mandatory; scrollbar-width: none; touch-action: pan-y; }
    .swipe::-webkit-scrollbar { display: none; }
    .swipe > span { display: block; height: 100%; scroll-snap-align: start; scroll-snap-stop: always; }
    .dev :global(.phone) { transform-origin: 0 0; transition: transform var(--duration-scene) var(--ease-scene); will-change: transform; }
    .dev :global(.phone-cap) { position: absolute; z-index: 2; bottom: 6px; left: 50%; transform: translateX(-50%); padding: 6px 10px; border-radius: 99px; background: var(--bg); white-space: nowrap; }
  }
  @media (max-width: 47.99rem) and (prefers-reduced-motion: reduce) { .dev :global(.phone) { transition: none; } }

  @media (min-width: 48rem) {
    .stage {
      /* Legenda alinhada ao topo do aparelho (centralizada sobrava espaço sob o título da seção). */
      grid-template-rows: none; grid-template-columns: minmax(0, 1fr) auto; align-items: start; gap: 48px;
      padding-top: 88px; padding-bottom: 24px;
      --phone-w: clamp(220px, calc((100svh - 88px - 24px - 40px) * 9 / 19.5), 320px);
    }
    .dev-row { display: contents; }
    .dev { order: 0; }
  }
  @media (min-width: 64rem) {
    .stage { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 24px; --phone-w: clamp(240px, calc((100svh - 88px - 24px - 40px) * 9 / 19.5), 340px); }
    /* Notebook + celular: mais espaço para os aparelhos, celular um pouco menor. */
    .duo .stage {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      --phone-w: clamp(200px, calc((100svh - 88px - 24px - 40px) * 9 / 19.5 * 0.82), 270px);
      --lap-w: clamp(360px, 34vw, 520px);
    }
  }

  .cap { min-width: 0; }
  .cap-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .cap-count { color: var(--brown); }
  .dots { display: flex; }
  .dot { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 0; background: none; cursor: pointer; border-radius: 99px; }
  .dot i { display: block; width: 8px; height: 8px; border-radius: 99px; background: var(--line-strong); transition: width var(--duration-base) var(--ease-out), background-color var(--duration-fast) var(--ease-out); }
  .dot[aria-current="step"] i { width: 22px; background: var(--ink); }
  /* Trilho (celular): bolinhas numeradas nas pontas e no meio, linha que enche com a rolagem. */
  .rail { position: relative; display: flex; flex-direction: column; justify-content: space-between; align-items: center; padding: 6px 0; }
  .rail-track { position: absolute; top: 20px; bottom: 20px; left: 50%; width: 2px; margin-left: -1px; border-radius: 99px; background: var(--line); overflow: hidden; }
  .rail-fill { position: absolute; inset: 0; background: var(--ink); transform-origin: 50% 0; transform: scaleY(var(--p, 0)); }
  .rail-dot { position: relative; display: grid; place-items: center; width: 28px; height: 28px; padding: 0; border-radius: 99px; border: 1.5px solid var(--line-strong); background: var(--bg); color: var(--ink-3); font-family: var(--font-label); font-weight: 600; font-size: 11px; cursor: pointer; transition: background-color var(--duration-base) var(--ease-out), border-color var(--duration-base) var(--ease-out), color var(--duration-base) var(--ease-out); }
  .rail-dot::after { content: ""; position: absolute; inset: -8px; }
  .rail-dot.done { border-color: var(--ink); color: var(--ink); }
  .rail-dot[aria-current="step"] { border-color: var(--ink); background: var(--ink); color: var(--bg); }

  /* Legendas empilhadas: a troca é um cruzamento suave, sem a altura pular. */
  .cap-items { display: grid; margin-top: 2px; }
  .cap-item { grid-area: 1 / 1; opacity: 0; visibility: hidden; transform: translateY(8px); transition: opacity var(--duration-reveal) var(--ease-out), transform var(--duration-reveal) var(--ease-out), visibility 0s linear var(--duration-reveal); }
  .cap-item.on { opacity: 1; visibility: visible; transform: none; transition: opacity var(--duration-reveal) var(--ease-out) 80ms, transform var(--duration-reveal) var(--ease-out) 80ms, visibility 0s; }
  .cap-txt { margin-top: 8px; color: var(--ink-2); font-size: var(--text-body); max-width: 40ch; }
  .cap-nav { display: none; }
  .swipe-hint { display: flex; align-items: center; gap: 6px; margin-bottom: 12px; color: var(--ink-3); }

  /* Celular: a contagem e as bolinhas passam para o trilho. */
  @media (max-width: 47.99rem) { .cap-top { display: none; } }
  @media (min-width: 48rem) {
    .rail, .swipe, .swipe-hint { display: none; }
    .cap { padding-top: 24px; }
    .cap-top { justify-content: flex-start; }
    .dots { order: 2; margin-left: auto; }
    .cap-items { margin-top: 20px; }
    .cap-txt { margin-top: 12px; font-size: var(--text-body); }
    .cap-nav { display: flex; gap: 12px; margin-top: 32px; }
  }

  /* Sem JS: legenda completa, sem palco fixo. */
  :global(html:not(.js)) .stage { position: static; height: auto; }
  :global(html:not(.js)) .markers, :global(html:not(.js)) .dots, :global(html:not(.js)) .cap-nav, :global(html:not(.js)) .rail, :global(html:not(.js)) .swipe, :global(html:not(.js)) .swipe-hint { display: none; }
  :global(html:not(.js)) .dev-row { display: block; }
  :global(html:not(.js)) .cap-items { display: block; list-style: decimal inside; }
  :global(html:not(.js)) .cap-item { opacity: 1; visibility: visible; transform: none; margin-top: 16px; }

  @media (prefers-reduced-motion: reduce) {
    .dot i, .rail-dot, .cap-item, .cap-item.on { transition: none; }
    .cap-item { transform: none; }
  }
</style>
