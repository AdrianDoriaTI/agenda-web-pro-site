---
// Funcionalidades (DESIGN §5.8): lista editorial com filete e numeração, sem cartões nem ícones.
// Em lg, itens de destaque ocupam 7 colunas e os demais 5, alternando para quebrar a repetição.
import { funcionalidades } from '../data/conteudo';
const pad = (n: number) => String(n).padStart(2, '0');
---
<section id="funcionalidades" class="section" aria-labelledby="func-titulo">
  <div class="wrap">
    <p class="t-label reveal" style="color:var(--brown)">Funcionalidades</p>
    <h2 id="func-titulo" class="t-h2 reveal" style="--i:1;margin-top:16px;max-width:18ch">O que o sistema faz por você</h2>
    <ol class="feats">
      {funcionalidades.map((f, i) => (
        <li class="feat reveal" style={`--i:${i % 3}`}>
          <p class="t-label tnum feat-n">{pad(i + 1)}</p>
          <h3 class="feat-t">{f.titulo}</h3>
          <p class="feat-x">{f.texto}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .feats { display: grid; gap: 0 24px; margin-top: 40px; }
  .feat { padding: 20px 0 28px; border-top: 1px solid var(--line); }
  .feat:last-child { padding-bottom: 0; }
  /* Menos respiro antes do Plano (somava ~190 px no celular). */
  #funcionalidades { padding-bottom: 40px; }
  @media (min-width: 48rem) { #funcionalidades { padding-bottom: 64px; } }
  .feat-n { color: var(--brown); }
  .feat-t { margin-top: 14px; font-size: var(--text-h3); line-height: 1.15; font-weight: 600; letter-spacing: -0.01em; }
  .feat-x { margin-top: 10px; color: var(--ink-2); max-width: 46ch; }

  /* Uma funcionalidade por linha; no computador: número | título | texto. */
  @media (min-width: 48rem) {
    .feats { margin-top: 56px; }
    .feat { display: grid; grid-template-columns: 64px minmax(0, 5fr) minmax(0, 6fr); gap: 0 24px; align-items: baseline; padding: 28px 0 32px; }
    .feat:last-child { padding-bottom: 0; }
    .feat-t, .feat-x { margin-top: 0; }
    .feat-t { font-size: clamp(1.5rem, 1.15rem + 0.8vw, 2rem); font-weight: 700; letter-spacing: -0.02em; }
  }
</style>
