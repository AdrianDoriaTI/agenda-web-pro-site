---
import type { Acao } from '../config/site';
interface Props { acao: Acao; variant?: 'primary' | 'secondary'; compact?: boolean; arrow?: boolean }
const { acao, variant = 'primary', compact = false, arrow = true } = Astro.props;
const isWhats = acao.tipo === 'whatsapp';
const label = compact ? acao.rotuloCurto : acao.rotulo;
---
<a
  href={acao.href}
  class:list={['btn', variant === 'primary' ? 'btn-primary' : 'btn-secondary', compact && 'btn-sm']}
  {...(isWhats ? { target: '_blank', rel: 'noopener' } : {})}
>
  {isWhats && (
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 20l1.3-4.2A8 8 0 1 1 8.4 18.8L4 20Z"/>
      <path d="M9.2 9.2c.3 2.2 2.4 4.3 4.6 4.6l1.1-1.1-1.9-1-.8.7c-.9-.4-1.6-1.1-2-2l.7-.8-1-1.9-.7.5Z"/>
    </svg>
  )}
  <span>{label}</span>
  {!isWhats && arrow && (
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 12h14M13 6l6 6-6 6"/>
    </svg>
  )}
</a>
